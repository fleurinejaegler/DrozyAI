# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ============================================================
# Large files (everywhere)
# ============================================================
*.h5
*.pkl
!/data/processed/baseline_model.pkl
*.npz
*.pt
*.pth
*.mp4
*.avi
*.mov
*.zip
*.tar.gz
*.csv

# ============================================================
# Data rules (later rules override earlier)
# ============================================================
/data/raw/
/data/processed/*.parquet

# Allow small derived files for team sharing
!/data/processed/full_dataset.parquet
!/data/processed/baseline_scores.parquet
!/data/processed/tradeoff_curve.csv

# Reference code
/reference/

# Model checkpoints
checkpoints/
models/*.pt

# Secrets
.env
*.pem
*.key

# Editors
.vscode/
.idea/

# Isaac's small, reviewed model artifacts only; keep blanket raw-data exclusions.
!/data/processed/small_tcn.pt
!/data/processed/tcn_scaler.joblib
!/data/processed/facial_model.pkl

# Local camera/session exports and review environments
web/session-exports/
.review-venv/
.upload-review-deps/
.env.*
!.env.example
*.download
*.crdownload
*.mkv
*.webm
*.m4v
*.7z
*.rar

# Connect IQ build output and signing key
/DrowsyApp/DrowsyAlert/bin/
/developer_key
*.prg
*.prg.debug.xml
*.iq
/.codex-task-cache/
/server/data/

# iPhone companion build output and local Xcode settings
/phone-companion/DerivedData/
/phone-companion/build/
xcuserdata/
*.xcuserstate
