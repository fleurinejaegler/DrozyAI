# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ============================================================
# Large files (everywhere)
# ============================================================
*.h5
*.pkl
!/data/processed/baseline_model.pkl
*.npz
*.pt
*.pth
*.mp4
*.avi
*.mov
*.zip
*.tar.gz
*.csv

# ============================================================
# Data rules (later rules override earlier)
# ============================================================
/data/raw/
/data/processed/*.parquet

# Allow small derived files for team sharing
!/data/processed/full_dataset.parquet
!/data/processed/baseline_scores.parquet
!/data/processed/tradeoff_curve.csv

# Reference code
/reference/

# Model checkpoints
checkpoints/
models/*.pt

# Secrets
.env
*.pem
*.key

# Editors
.vscode/
.idea/

# Connect IQ build output and signing key
/DrowsyApp/DrowsyAlert/bin/
/developer_key
*.prg
*.prg.debug.xml
*.iq

# iPhone companion build output and local Xcode settings
/phone-companion/DerivedData/
/phone-companion/build/
xcuserdata/
*.xcuserstate
